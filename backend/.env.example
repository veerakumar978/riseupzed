# Riseupzed Backend Environment Configuration Example
# Copy this file to .env and adjust variables for your local setup

PROJECT_NAME="Riseupzed API"
VERSION="1.0.0"
ENVIRONMENT="development"
DEBUG=true
LOG_LEVEL="INFO"

# PostgreSQL Database Connection
# Standard format: postgresql+psycopg://<username>:<password>@<host>:<port>/<database_name>
DATABASE_URL="postgresql+psycopg://postgres:postgres@localhost:5432/riseupzed_db"
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_PRE_PING=true

# Allowed CORS Origins (comma-separated or JSON list)
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000"
